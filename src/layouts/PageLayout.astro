---
// Layout used by the Markdown pages (our-story.md, support.md).
// Anything written in those files lands inside the <slot />.
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <h1>{frontmatter.title}</h1>
  {frontmatter.lede && <p class="lede">{frontmatter.lede}</p>}
  <div class="prose">
    <slot />
  </div>
</BaseLayout>
