---
import BaseLayout from '../layouts/BaseLayout.astro';
import { classes, curriculum, personId } from '../data/site.js';

// Group the classes by level so each level gets its own heading.
const levels = [...new Set(classes.map((c) => c.level))];
---

<BaseLayout title="Classes" description="Free math and science classes offered over Zoom.">
  <h1>Classes</h1>
  <p class="lede">
    Sessions are small enough that students can ask questions.
  </p>

  {levels.map((level) => (
    <section class="classes-level">
      <h2>{level}</h2>
      <div class="timetable">
        {classes.filter((c) => c.level === level).map((c) => (
          <div class="timetable-row">
            <span class="subject">{c.name}</span>
            <span class="meta">
              Taught by <a href={`/team/#${personId(c.instructor)}`}>{c.instructor}</a>
            </span>
          </div>
        ))}
      </div>
    </section>
  ))}

  <div class="split">
    <div class="split-text">
      <h2>What a session looks like</h2>

      <p>
        Sessions run an hour and fifteen minutes, twice a week. We teach live on
        a Zoom whiteboard using Notability, working through practice problems
        together.
      </p>

      <p><a href="/contact/">Ask about a class</a></p>
    </div>

    <aside>
      <h2>Curriculum</h2>

      <p>
        Everything we teach from is in one folder: notes, practice problems, and
        worked solutions.
      </p>

      <p>
        <a class="button-link" href={curriculum.href} target="_blank" rel="noopener">
          {curriculum.label}
        </a>
      </p>
    </aside>
  </div>

  <h2>Common questions</h2>

  <div class="faq">
    <details>
      <summary>How often are classes offered?</summary>
      <p>
        Classes run every fall, winter, and spring, and twice over the summer.
      </p>
    </details>

    <details>
      <summary>How many weeks is each class?</summary>
      <p>Each class runs for three to four weeks.</p>
    </details>

    <details>
      <summary>What if I miss a session?</summary>
      <p>
        Every Zoom session is recorded. Contact us and we will send the
        recorded lecture to you, so missing a class doesn't mean missing material.
      </p>
    </details>

    <details>
      <summary>Can I join from outside the United States?</summary>
      <p>
        Yes. The only catch is that sessions are scheduled around American time
        zones, so check what that works out to where you are before signing up.
      </p>
    </details>

    <details>
      <summary>Do you offer one-on-one tutoring?</summary>
      <p>
        One-on-one tutoring can be requested through the
        <a href="/contact/">contact form</a>.
      </p>
    </details>

    <details>
      <summary>Can parents or guardians get in touch with questions?</summary>
      <p>
        Yes. Parents and guardians are welcome to email the Helping Hands team
        with any questions, through the <a href="/contact/">contact page</a>.
      </p>
    </details>
  </div>
</BaseLayout>