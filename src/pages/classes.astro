---
import BaseLayout from '../layouts/BaseLayout.astro';
import { classes, curriculum, personId } from '../data/site.js';

// Group the classes by level so each level gets its own heading.
const levels = [...new Set(classes.map((c) => c.level))];
---

<BaseLayout title="Classes" description="Free math and science classes offered over Zoom.">
  <h1>Classes</h1>
  <p class="lede">
    Every class is free and runs over Zoom. Sessions are small enough that
    students can ask questions.
  </p>

  {levels.map((level) => (
    <section class="classes-level">
      <h2>{level}</h2>
      <div class="timetable">
        {classes.filter((c) => c.level === level).map((c) => (
          <div class="timetable-row">
            <span class="subject">{c.name}</span>
            <span class="meta">
              Taught by <a href={`/team/#${personId(c.instructor)}`}>{c.instructor}</a>
            </span>
          </div>
        ))}
      </div>
    </section>
  ))}

  <div class="split">
    <div class="split-text">
      <h2>What a session looks like</h2>

      <p>
        Sessions run an hour and fifteen minutes, twice a week. We teach live on
        a Zoom whiteboard using Notability, working through practice problems
        together rather than lecturing at you.
      </p>

      <p>
        Most of the time goes on problems and the questions they raise. Students
        are expected to interrupt — if something does not make sense, that is
        the part worth spending the time on.
      </p>

      <p><a href="/contact/">Ask about a class</a></p>
    </div>

    <aside>
      <h2>Curriculum</h2>

      <p>
        Everything we teach from is in one folder: notes, practice problems, and
        worked solutions, free to use whether or not you attend a class.
      </p>

      <p>
        <a class="button-link" href={curriculum.href} target="_blank" rel="noopener">
          {curriculum.label}
        </a>
      </p>
    </aside>
  </div>

  <h2>Common questions</h2>

  <div class="faq">
    <details>
      <summary>Does it cost anything?</summary>
      <p>
        No. Every class is free, and always has been. We do not take donations
        and there is nothing to pay at any point.
      </p>
    </details>

    <details>
      <summary>Who can join?</summary>
      <p>
        Any student roughly between 6th and 12th grade. You do not need to be at
        a particular school or live in a particular place — classes run over
        Zoom and students join from across the country.
      </p>
    </details>

    <details>
      <summary>What if I am behind in the subject?</summary>
      <p>
        That is who the class is for. Sessions move at a pace the students in
        them can follow, and asking a question about something from two years
        ago is normal here.
      </p>
    </details>

    <details>
      <summary>What if I have already covered this at school?</summary>
      <p>
        Plenty of students come back to material they have seen before, either to
        make it stick or to go further than their syllabus does. Both are fine.
      </p>
    </details>

    <details>
      <summary>What do I need to join a session?</summary>
      <p>
        Zoom, and something to write with. We teach on a shared whiteboard, so
        you can follow along on paper or on a tablet, whichever you prefer.
      </p>
    </details>

    <details>
      <summary>What if I miss a session?</summary>
      <p>
        Every Zoom session is recorded. Send us a message and we will pass the
        recording on, so missing a week does not mean falling behind.
      </p>
    </details>

    <details>
      <summary>Can I join from outside the United States?</summary>
      <p>
        Yes. Students have joined from several countries. The only catch is that
        sessions are scheduled around American time zones, so check what that
        works out to where you are before signing up.
      </p>
    </details>

    <details>
      <summary>How do I sign up?</summary>
      <p>
        Send us a message on the <a href="/contact/">contact page</a> saying which
        subject you are after and what grade you are in, and we will tell you when
        the next session runs.
      </p>
    </details>
  </div>
</BaseLayout>