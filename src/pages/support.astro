---
import BaseLayout from '../layouts/BaseLayout.astro';
import { support } from '../data/site.js';

// Prose is plain text between <p> tags — edit it like a document.
// Both photos are set in src/data/site.js.
---

<BaseLayout title="Support Us" description="How to help Helping Hands: teach a class, or tell someone about us.">
  <h1>Support Us</h1>

  <div class="split">
    <div class="split-text">
      <h2>Volunteer as an instructor</h2>

      <p>
        Do you enjoy a subject and want to help someone else understand it?
        We&rsquo;d love to have you join us.
      </p>

      <p>
        You don&rsquo;t need to be a professional teacher or have previous
        teaching experience. If you understand a subject well, enjoy working with
        students, and are willing to share what you know, you can make a
        difference. Many of our instructors started with nothing more than a
        strong understanding of a subject and a desire to help.
      </p>

      <p>
        Our classes are held live on Zoom for about an hour and fifteen minutes,
        twice a week. You can choose the subject you&rsquo;d like to teach and
        work with us to find a schedule that fits your availability.
      </p>

      <p>
        Whether you&rsquo;re a student, a professional, or simply someone who
        loves teaching, there&rsquo;s a place for you at Helping Hands. Share what
        you know, help a student grow, and be part of making learning more
        accessible.
      </p>

      <p>
        <a class="button-link" href="/contact/">Get in touch</a>
      </p>
    </div>

    <div class="split-media">
      <img src={support.image} alt={support.imageAlt} />
    </div>
  </div>

  <div class="split">
    <div class="split-text">
      <h2>Spread the word</h2>

      <p>
        A lot of our students find us because someone tells them about Helping
        Hands.
      </p>

      <p>
        Know a student who could use some extra help with math or science? Send
        them our way. Tell a friend, share our website, or pass it along to a
        teacher or parent who might find it useful.
      </p>

      <p>
        It only takes a minute, and it could help us reach a student who needs
        us.
      </p>
    </div>

    <div class="split-media split-media--plain">
      <img src={support.spreadImage} alt={support.spreadAlt} />
    </div>
  </div>
</BaseLayout>